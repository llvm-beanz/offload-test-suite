#--- source.hlsl
Buffer<uint> In : register(t0);
RWBuffer<uint> Out : register(u1);

uint checkMask(uint id, uint expected) {
  return WaveActiveBitOr(1u << id) == expected;
}

[numthreads(4, 1, 1)]
void main(uint3 tid : SV_GroupThreadID) {
  uint id = tid.x;
  uint passed = 0;
  switch (In[id]) {
  case 0:
    passed |= checkMask(id, 0x5);
    if (id == 2)
      break;
    passed |= checkMask(id, 0x1) << 1;
  case 1:
    // Thread 2 broke out; thread 0 falls through to join thread 1.
    passed |= checkMask(id, 0x3) << 2;
    if (id & 1)
      passed |= checkMask(id, 0x2) << 3;
    else
      passed |= checkMask(id, 0x1) << 3;
    passed |= checkMask(id, 0x3) << 4;
    if (id == 1)
      break;
  case 2:
    passed |= checkMask(id, 0x9) << 5;
    break;
  }
  passed |= checkMask(id, 0xf) << 6;
  Out[id] = passed;
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: UInt32
    Data: [ 0, 1, 0, 2 ]
  - Name: Out
    Format: UInt32
    Data: [ 0, 0, 0, 0 ]
  - Name: Expected
    Format: UInt32
    Data: [ 127, 92, 65, 96 ]
Results:
  - Result: FallthroughBreak
    Rule: BufferExact
    Actual: Out
    Expected: Expected
DescriptorSets:
  - Resources:
    - Name: In
      Kind: Buffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Od -Fo %t.od.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.od.o
# RUN: %dxc_target -T cs_6_0 -O3 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
